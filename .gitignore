# ==============================================================================
# GITIGNORE RAÍZ: CoWorkSpace Calatrava (Monorepo Backend + Frontend)
# ==============================================================================

# --- Archivos de Entorno y Secretos (CRÍTICO) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- IDEs y Editores de Sistema ---
.idea/
*.iws
*.iml
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# --- Logs y Temporales ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- BACKEND (Java / Maven / Spring Boot) ---
backend/HELP.md
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/*.log
backend/.apt_generated
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings
backend/.springBeans
backend/.sts4-cache

# --- FRONTEND (Node / Vite / React) ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
frontend/coverage/
frontend/*.local
frontend/.eslintcache
